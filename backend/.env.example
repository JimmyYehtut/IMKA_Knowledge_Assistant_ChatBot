# Google Gemini Key
GOOGLE_API_KEY=

# Anthropic Claude Key
ANTHROPIC_API_KEY=

# OpenAI Key
OPENAI_API_KEY=

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Qdrant configuration (run via `docker compose up -d`)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME="ragindex"

# PostgreSQL configuration (run via `docker compose up -d`) — chat log + user accounts
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/imka"
JWT_SECRET="change-this-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION="1024"
# Embeddings: "openai" (OPENAI_EMBEDDING_MODEL) or "qwen" — Qwen3-Embedding-4B on the same RunPod
# endpoint (v21+), cut to EMBEDDING_DIMENSION (32-2560). A different provider or dimension needs its
# own QDRANT_COLLECTION_NAME. QWEN_EMBED_INSTRUCTION overrides the query-side instruction.
EMBEDDING_PROVIDER="openai"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Chat LLM for intent, query rewrite, answers and topics: "openai" (OPENAI_CHAT_MODEL) or
# "qwen" — Qwen3.8-27B on the RunPod serverless llama.cpp endpoint (rag/qwen_client.py).
# Embeddings are set separately (EMBEDDING_PROVIDER).
LLM_PROVIDER="openai"
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# QWEN_MODEL_ALIAS=   # name reported for runs, default Qwen3.8-27B-UD-Q4_K_XL

# Docling ingestion option (CLI and POST /api/documents); adds one LLM call per figure.
# CAPTION_FIGURES=1: VLM description of each figure's content — chart readings, plate values,
#                    callouts (DOCLING_CAPTION_MODEL: an OpenAI vision model, default gpt-5.6-luna,
#                    or "qwen" for the RunPod endpoint; DOCLING_CAPTION_CONCURRENCY figures described
#                    in parallel, default 8)
CAPTION_FIGURES="1"
# Optional. Sent to the chat model only when set; 0 gives the most repeatable
# answers. Leave it out for models that only accept their default temperature
# (they reject the request otherwise).
OPENAI_TEMPERATURE="0"

# LangSmith tracing (optional) — set LANGCHAIN_TRACING_V2=true and an API key
# from https://smith.langchain.com/settings to see every LLM/chain run (intent
# classification, query rewrite, RAG generation) in the LangSmith UI.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="imka-knowledge-assistant"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
